# Aura Backend Environment Variables
SERVER_PORT=8080
SERVER_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=aura_db
DB_SSLMODE=disable

# Authentication Secret & Session Security
JWT_SECRET=super_secret_aura_jwt_key_hani_2026
COOKIE_SECURE=false
COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Static File Uploads Directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
